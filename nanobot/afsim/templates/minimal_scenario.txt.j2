# Generated by afsim-scenario-builder. Validate before execution.
# scenario_id: {{ scenario.scenario_id }}
# mission_id: {{ scenario.mission.mission_id }}

{% for sensor in scenario.sensors %}
sensor {{ sensor.sensor_type_id }} {{ sensor.base_type }}
   mode_template
      frame_time {{ sensor.frame_time_s | number }} sec
{% if sensor.reports_location %}
      reports_location
{% endif %}
   end_mode_template
   mode {{ sensor.mode_name }}
      maximum_range {{ sensor.maximum_range_m | number }} m
   end_mode
{% if sensor.ignore_same_side %}
   ignore_same_side
{% endif %}
end_sensor

{% endfor %}
{% if scenario.engagements %}
weapon_effects AUTO_ENGAGEMENT_EFFECT WSF_SPHERICAL_LETHALITY
   maximum_damage 1
   minimum_damage 0.99
   maximum_radius 100 km
   minimum_radius 0 m
end_weapon_effects

{% endif %}
{% for platform_type, mover_type in unique_types %}
platform_type {{ platform_type }}
{% if mover_type %}
   mover {{ mover_type }}
{% endif %}
   radar_signature 10dB_FuzzBall
      constant 10 dBsm
   end_radar_signature
end_platform_type

{% endfor %}
{% for platform in scenario.platforms %}
platform {{ platform.platform_id }} {{ platform.platform_type }}
   side {{ platform.side.value }}
   position {{ platform.position | position }} heading {{ platform.heading_deg | number }} deg
{% if platform.mover_type %}
   add mover {{ platform.mover_type }}
   end_mover
{% endif %}
{% for sensor in platform.sensors %}
   add sensor {{ sensor.instance_name }} {{ sensor.sensor_type_id }}
{% if sensor.enabled %}
      on
{% endif %}
      initial_mode {{ sensor.initial_mode }}
   end_sensor
{% endfor %}
{% for weapon in platform.weapons %}
   add weapon {{ weapon.instance_name }} {{ weapon.weapon_type }}
      update_interval {{ weapon.update_interval_s | number }} sec
      weapon_effects AUTO_ENGAGEMENT_EFFECT
      quantity {{ weapon.quantity }}
   end_weapon
{% endfor %}
{% if platform.route %}
   route
{% for point in platform.route %}
      position {{ point | route_position }}
{% endfor %}
   end_route
{% endif %}
{% for engagement in scenario.engagements %}
{% if engagement.shooter_platform == platform.platform_id %}
   execute at_time {{ engagement.fire_time_s | number }} sec absolute
      Weapon("{{ engagement.weapon_name }}").Fire(WsfSimulation.FindPlatform("{{ engagement.target_platform }}").MakeTrack());
   end_execute
{% endif %}
{% endfor %}
end_platform

{% endfor %}
event_output
   file events.evt
   enable SENSOR_DETECTION_ATTEMPT
   enable SENSOR_TRACK_INITIATED
   enable WEAPON_FIRED
end_event_output

event_pipe
   file replay.aer
end_event_pipe

end_time {{ scenario.mission.duration_s | number }} sec
